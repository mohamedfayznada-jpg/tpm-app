# Configure these values in Vercel Project Settings for Preview and Production.
# Never commit real credentials to Git.
OPENROUTER_API_KEY=
IMGBB_API_KEY=

# Meta WhatsApp Cloud API (server-side only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_GRAPH_API_VERSION=v23.0

# Firebase token validation for the WhatsApp endpoint.
# Use the Firebase Web App projectId, not an API key.
FIREBASE_PROJECT_ID=
# Comma-separated emails permitted to request WhatsApp sends (for example: admin@company.com)
TPM_NOTIFICATION_ALLOWED_EMAILS=
