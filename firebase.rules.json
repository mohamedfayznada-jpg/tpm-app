{
  "rules": {
    "tpm_system": {
      ".read": "auth != null",
      "api_keys": {
        ".write": "auth != null && root.child('tpm_system/users/' + auth.uid + '/role').val() === 'admin'"
      },
      "departments": {
        ".write": "auth != null && root.child('tpm_system/users/' + auth.uid + '/role').val() === 'admin'"
      },
      "maintenanceEngineers": {
        ".write": "auth != null && root.child('tpm_system/users/' + auth.uid + '/role').val() === 'admin'"
      },
      "history": {
        ".indexOn": ["id", "dept", "auditor"],
        ".write": "auth != null && (root.child('tpm_system/users/' + auth.uid + '/role').val() === 'admin' || root.child('tpm_system/users/' + auth.uid + '/role').val() === 'auditor')"
      },
      "tasks": {
        ".indexOn": ["id", "dept"],
        ".write": "auth != null"
      },
      "tags": {
        ".indexOn": ["id", "dept", "status"],
        ".write": "auth != null"
      },
      "losses": {
        ".indexOn": ["id", "dept", "lossId"],
        ".write": "auth != null"
      },
      "pdca": {
        ".indexOn": ["id", "dept", "status"],
        ".write": "auth != null"
      },
      "jh_kpis": { ".write": "auth != null" },
      "jh_records": { ".write": "auth != null" },
      "jh_main_team": {
        ".write": "auth != null && root.child('tpm_system/users/' + auth.uid + '/role').val() === 'admin'"
      },
      "clit_executions": { ".write": "auth != null" },
      "dept_goals": { ".write": "auth != null" },
      "knowledgeBase": { ".write": "auth != null" },
      "pdf_files": { ".write": "auth != null" },
      "global_achievements": { ".write": "auth != null" },
      "notification_settings": {
        ".write": "auth != null && root.child('tpm_system/users/' + auth.uid + '/role').val() === 'admin'"
      },
      "kaizenComments": { ".write": "auth != null" },
      "likes": { ".write": "auth != null" },
      "users": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('tpm_system/users/' + auth.uid + '/role').val() === 'admin')"
        }
      },
      "points": { ".write": "auth != null" },
      "logs": { ".write": "auth != null" }
    }
  }
}
